# Read at build time (`npm run build`) and baked into the static files.
# Both values are public by design — never put secret keys here, since every
# NEXT_PUBLIC_ variable ends up in the browser bundle.

# Supabase project used by the Kingdom CMS (shared with Omni — only kingdom_*
# tables/policies and the kingdom-media bucket belong to this site).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_SENTRY_DSN=

# The contact form's email key is NOT here — it lives on the server in
# kingdom-config.php (see public/api/contact.php).
